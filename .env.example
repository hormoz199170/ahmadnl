APP_ENV=local
TELEGRAM_BOT_TOKEN=replace-with-token
DATABASE_URL=sqlite+aiosqlite:///./ahmadnl.db
STORAGE_DIR=./storage
GEMINI_API_KEY=replace-with-key
GEMINI_MODEL=gemini-1.5-flash
PDF_MAX_BYTES=10485760
PDF_MAX_PAGES=80
AI_MAX_INPUT_CHARS=60000
AI_MAX_OUTPUT_TOKENS=1200
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
AI_CONCURRENCY=2
DAILY_FREE_CREDITS=3
SUMMARY_CREDIT_COST=1
KEY_POINTS_CREDIT_COST=1
STUDY_QUESTIONS_CREDIT_COST=1
ANSWER_GUIDANCE_CREDIT_COST=1
DEV_PURCHASES_ENABLED=false
